<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WAEC Timetable Generator</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  
  <!-- Google Fonts: DM Serif Display + Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #4F46E5;
      --primary-dark: #4338CA;
      --primary-light: #A5B4FC;
      --accent: #F59E0B;
      --accent2: #10B981;
      --bg: #F8FAFC;
      --card-bg: #FFFFFF;
      --text: #1E293B;
      --text-muted: #64748B;
      --border: #E2E8F0;
      --shadow: 0 10px 30px rgba(79, 70, 229, 0.12);
      --radius: 16px;
      --font-main: 'Poppins', sans-serif;
      --font-display: 'DM Serif Display', serif;
    }

    * { box-sizing: border-box; }
    
    body {
      font-family: var(--font-main);
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 0;
      animation: fadeIn 0.6s ease-out;
    }

    /* HEADER with gradient + wave + decorative circles */
    .header {
      position: relative;
      width: 100%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      padding: 60px 20px 80px;
      text-align: center;
      color: white;
      clip-path: ellipse(100% 100% at 50% 0%);
      overflow: hidden;
    }
    .header::before, .header::after {
      content: '';
      position: absolute;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
    }
    .header::before {
      width: 200px; height: 200px;
      top: -80px; left: -50px;
    }
    .header::after {
      width: 150px; height: 150px;
      bottom: -60px; right: -40px;
    }
    .badge {
      display: inline-block;
      background: var(--accent);
      color: white;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }
    .app-icon { font-size: 56px; margin-bottom: 8px; }
    .app-name {
      font-family: var(--font-display);
      font-size: 32px;
      margin: 0;
    }
    .tagline {
      font-size: 14px;
      opacity: 0.9;
      margin-top: 6px;
    }

    /* CARD CONTAINER */
    .container {
      max-width: 520px;
      margin: -40px auto 40px;
      padding: 0 20px;
      position: relative;
      z-index: 2;
    }
    .card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      display: block;
      margin-top: 16px;
      margin-bottom: 6px;
    }
    input, select {
      width: 100%;
      padding: 14px;
      border-radius: 10px;
      border: 1.5px solid var(--border);
      font-family: var(--font-main);
      font-size: 15px;
      background: var(--bg);
      color: var(--text);
      transition: border 0.2s;
    }
    input:focus, select:focus {
      outline: none;
      border-color: var(--primary-light);
    }

    /* DOWNLOAD CARD BUTTON */
    button {
      width: 100%;
      padding: 16px;
      margin-top: 24px;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent2) 100%);
      color: white;
      border: none;
      border-radius: 12px;
      font-family: var(--font-main);
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative;
      animation: pulse-glow 2s infinite;
    }
    button:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(79, 70, 229, 0.25);
    }
    button:disabled {
      opacity: 0.7;
      cursor: not-allowed;
      animation: none;
    }
    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: white;
      border-radius: 50%;
      margin-right: 8px;
      animation: spin 0.8s linear infinite;
    }
    #status {
      text-align: center;
      margin-top: 16px;
      font-size: 15px;
      font-weight: 600;
      color: var(--primary);
      height: 24px;
    }

    /* ANIMATIONS */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    @keyframes pulse-glow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.4); }
      50% { box-shadow: 0 0 0 10px rgba(79, 70, 229, 0); }
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="badge">AI-POWERED TOOL</div>
    <div class="app-icon">📅</div>
    <h1 class="app-name">WAEC Timetable Generator</h1>
    <p class="tagline">Personalized after-school study plan in 10 seconds</p>
  </div>

  <div class="container">
    <div class="card">
      <label>Class Level</label>
      <select id="class">
        <option>SS1</option><option>SS2</option><option selected>SS3</option>
      </select>

      <label>School Closes Time</label>
      <input type="time" id="closes" value="15:00">

      <label>Study Time</label>
      <select id="studyTime">
        <option>morning_reader</option>
        <option>afternoon_reader</option>
        <option selected>night_reader</option>
      </select>

      <label>All Subjects [comma separated]</label>
      <input type="text" id="subjects" placeholder="Math, English, Physics, Chemistry, Biology, Economics">

      <label>Weak Subjects [comma separated]</label>
      <input type="text" id="weak" placeholder="Physics, Math">

      <label>Strong Subjects [comma separated]</label>
      <input type="text" id="strong" placeholder="Biology, English">

      <button id="genBtn" onclick="generate()">
        Generate & Open Gem
      </button>
      <div id="status"></div>
    </div>
  </div>

  <script>
    const GEM_LINK = 'https://gemini.google.com/gem/1txG__ffFyU_1GpWm8J_YcROuHD_lzLPm?usp=sharing';
    const tg = window.Telegram.WebApp;
    tg.expand();

    async function generate() {
      const btn = document.getElementById('genBtn');
      const status = document.getElementById('status');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span>Downloading...';

      const data = {
        class: document.getElementById('class').value,
        closes: document.getElementById('closes').value,
        studyTime: document.getElementById('studyTime').value,
        subjects: document.getElementById('subjects').value,
        weak: document.getElementById('weak').value,
        strong: document.getElementById('strong').value
      };

      const prompt = `Class: ${data.class}
School closes: ${data.closes}
Study time: ${data.studyTime}
Subjects: ${data.subjects}
Weak subjects: ${data.weak}
Strong subjects: ${data.strong}

Generate my personalized WAEC after-school timetable in JSON format. Follow your WAEC Timetable Generator rules.`;

      await navigator.clipboard.writeText(prompt);
      
      let count = 3;
      const interval = setInterval(() => {
        status.innerText = `Copied! Opening Gem in ${count}...`;
        count--;
        if (count < 0) {
          clearInterval(interval);
          btn.innerHTML = 'Generate & Open Gem';
          btn.disabled = false;
          status.innerText = "Tap chat input → Paste → Send";
          tg.openLink(GEM_LINK);
        }
      }, 1000);
    }
  </script>
</body>
</html>
