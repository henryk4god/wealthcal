<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FACEBOOK MARKETING GENERATOR PROMPT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Poppins:wght=300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <span class="badge">AI-POWERED TOOL</span>
        <div class="icon-container">🎯</div>
        <h1>FACEBOOK MARKETING GENERATOR PROMPT</h1>
        <p>Paste your complete criteria block into the single input field below to build your architectural production prompt instantly.</p>
    </header>

    <main>
        <div class="form-card">
            <div class="template-selector">
                <label class="radio-label">
                    <input type="radio" name="template" value="template1" checked>
                    Template 1
                </label>
            </div>

            <form id="generatorForm">
                <div class="input-group">
                    <label for="singleInput">Product Input Block</label>
                    <textarea id="singleInput" placeholder="Problem Idea:&#10;Product Name:&#10;Subtitle:&#10;The Skill/Topic I Will Teach:&#10;The Resource They Already Have:&#10;Logical Step-By-Step Solution:&#10;Key Pain Points:&#10;Unique Value Proposition:&#10;Target Audience:" required></textarea>
                </div>

                <button type="submit" class="btn-generate" id="submitBtn">
                    <span class="spinner" id="spinner"></span>
                    <span id="btnText">Generate Master Prompt</span>
                </button>
            </form>
        </div>

        <div class="result-card" id="resultCard">
            <div class="result-header">
                <h2>Your Compiled System Prompt</h2>
                <button class="btn-copy" id="copyBtn">Copy Prompt</button>
            </div>
            <pre class="prompt-preview" id="promptOutput"></pre>
        </div>
    </main>

    <script src="script.js"></script>
</body>
</html>
