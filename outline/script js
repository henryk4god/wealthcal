// script.js - Core prompt generation engine following strict Nigerian/market-friendly rules

(function() {
  // Helper: parse steps from textarea (by lines or comma)
  function parseSteps(rawSteps) {
    if (!rawSteps.trim()) return ["Identify core goal", "Plan strategy", "Execute plan", "Measure results", "Optimize & scale"];
    let lines = rawSteps.split(/\r?\n/).filter(l => l.trim().length > 0);
    if (lines.length === 0) {
      let commaSplit = rawSteps.split(',').map(s => s.trim()).filter(s => s);
      if (commaSplit.length) return commaSplit;
      return [rawSteps.trim()];
    }
    return lines;
  }

  function parsePainPoints(rawPain) {
    if (!rawPain.trim()) return ["Lack of clarity", "Overwhelm", "No step-by-step roadmap", "Fear of failure", "Low confidence"];
    let lines = rawPain.split(/\r?\n/).filter(p => p.trim());
    if (lines.length === 0) {
      let comma = rawPain.split(',').map(p => p.trim()).filter(p => p);
      if (comma.length) return comma;
      return [rawPain.trim()];
    }
    return lines;
  }

  // Generate full product package (Ebook + Course) based strictly on input
  function generateFullPackage(productName, stepsArray, painPointsArray, uvp, audience) {
    // ensure at least 5 steps for minimum chapters
    let coreSteps = stepsArray.length ? stepsArray : ["Diagnose", "Strategy", "Execution", "Review", "Scale"];
    while (coreSteps.length < 5) {
      coreSteps.push(coreSteps[coreSteps.length - 1] + " (advanced)");
    }
    const step1 = coreSteps[0] || "Foundation";
    const step2 = coreSteps[1] || "Planning";
    const step3 = coreSteps[2] || "Implementation";
    const step4 = coreSteps[3] || "Optimization";
    const step5 = coreSteps[4] || "Scaling";

    const pain1 = painPointsArray[0] || "Unclear starting point";
    const pain2 = painPointsArray[1] || "Information overload";
    const pain3 = painPointsArray[2] || "No consistent system";
    
    const target = audience || "aspiring entrepreneurs";
    const uniqueValue = uvp || "Practical system to achieve results fast";

    // ------------------- EBOOK OUTLINE -------------------
    const ebookTitle = `${productName}: The Complete Roadmap to ${target.split(' ').slice(0, 3).join(' ')} Success`;
    const subtitle = `Eliminate ${pain1.toLowerCase()} and gain ${uniqueValue.toLowerCase()}`;
    const introPain = `You're tired of ${pain1.toLowerCase()}, struggling with ${pain2.toLowerCase()}, and tired of ${pain3.toLowerCase()}. This blueprint delivers exactly what you need.`;
    
    // chapters mapping to steps
    const chapters = [
      { name: `Chapter 1: ${step1} — The Clarity Shift`, topics: [`Understanding the root of ${pain1}`, `Applying ${step1} to break mental blocks`, `Actionable Exercise: Define your win condition`] },
      { name: `Chapter 2: ${step2} — Strategic Blueprint`, topics: [`Mapping ${step2} into weekly actions`, `Overcoming ${pain2} with a priority matrix`, `Actionable Exercise: 7-day sprint plan`] },
      { name: `Chapter 3: ${step3} — Execution Engine`, topics: [`Implementing ${step3} without overwhelm`, `Automation & workflow hacks`, `Actionable Exercise: Build your execution tracker`] },
      { name: `Chapter 4: ${step4} — Optimization & Growth`, topics: [`Using ${step4} to double results`, `Common pitfalls and how to dodge them`, `Actionable Exercise: Weekly audit sheet`] },
      { name: `Chapter 5: ${step5} — Scaling & Long-term Freedom`, topics: [`Scaling ${step5} for sustainable income`, `Systems & team leverage`, `Actionable Exercise: Create 90-day scale roadmap`] }
    ];
    
    let ebookChaptersText = "";
    chapters.forEach(ch => {
      ebookChaptersText += `\n\n**${ch.name}**\n  • ${ch.topics[0]}\n  • ${ch.topics[1]}\n  • ${ch.topics[2]}`;
    });
    
    const conclusion = `You now have a proven framework—from ${step1} to ${step5}. Implement and join thousands of ${target} achieving real results. Next step: Download the bonus checklist.`;
    const bonus = `✓ Quick-win checklist: "First 7 Days Launchpad" – daily tasks to kickstart your transformation.`;
    
    const pages = Math.floor(120 + coreSteps.length * 8);
    const priceNgn = `₦12,500 - ₦25,000`;
    const priceUsd = `$25 - $49`;
    
    // ------------------- COURSE CURRICULUM -------------------
    const courseTitle = `${productName} Accelerator: From ${pain1.split(' ')[0]} to Pro in 30 Days`;
    const tagline = `Master ${step1}, ${step2}, ${step3} and build a thriving ${target} career.`;
    const format = `Video + PDF workbooks (self-paced)`;
    const platform = `Teachable / Selar / Gumroad (optimized for African creators)`;
    
    // Modules tie to steps & pain points
    const module1 = {
      title: `MODULE 1: Foundation — Crushing ${pain1} & ${pain2}`,
      lessons: [`Lesson 1.1: Why most beginners fail at ${target}?`, `Lesson 1.2: Mindset reset & goal clarity`, `Lesson 1.3: ${step1} mini-workshop`],
      assignment: `Define your personal MVP milestones.`
    };
    const module2 = {
      title: `MODULE 2: Core Skill — ${step2} & Early Execution`,
      lessons: [`Lesson 2.1: Deep dive into ${step2} systems`, `Lesson 2.2: Avoiding ${pain3} with checklists`, `Lesson 2.3: Real case study of ${step2} success`],
      assignment: `Build your execution timeline using the template.`
    };
    const module3 = {
      title: `MODULE 3: Implementation — ${step3} & ${step4} Integration`,
      lessons: [`Lesson 3.1: ${step3} — tools & workflows`, `Lesson 3.2: Performance tracking & analytics`, `Lesson 3.3: ${step4} tactics to 2x output`],
      assignment: `Run a 5-day experiment using ${step3} method.`
    };
    const module4 = {
      title: `MODULE 4: Advanced Strategy — ${step5} & Scale Mechanics`,
      lessons: [`Lesson 4.1: ${step5} frameworks for scale`, `Lesson 4.2: Outsourcing & automation`, `Lesson 4.3: Building a personal brand as ${target}`],
      assignment: `Create your scale roadmap with revenue targets.`
    };
    const module5 = {
      title: `MODULE 5: Results & Scaling Mastery`,
      lessons: [`Lesson 5.1: Advanced monetization models`, `Lesson 5.2: Community & retention strategies`, `Lesson 5.3: Long-term wealth from ${productName}`],
      assignment: `Final Capstone: Launch a micro-offer to real audience.`
    };
    
    const modulesText = `
**${module1.title}**
  - ${module1.lessons[0]}
  - ${module1.lessons[1]}
  - ${module1.lessons[2]}
  - 🎯 Module Assignment: ${module1.assignment}

**${module2.title}**
  - ${module2.lessons[0]}
  - ${module2.lessons[1]}
  - ${module2.lessons[2]}
  - 🎯 Module Assignment: ${module2.assignment}

**${module3.title}**
  - ${module3.lessons[0]}
  - ${module3.lessons[1]}
  - ${module3.lessons[2]}
  - 🎯 Module Assignment: ${module3.assignment}

**${module4.title}**
  - ${module4.lessons[0]}
  - ${module4.lessons[1]}
  - ${module4.lessons[2]}
  - 🎯 Module Assignment: ${module4.assignment}

**${module5.title}**
  - ${module5.lessons[0]}
  - ${module5.lessons[1]}
  - ${module5.lessons[2]}
  - 🎯 Final Capstone: ${module5.assignment}
`;
    
    const estHours = `~ ${8 + coreSteps.length} hours`;
    const coursePriceNgn = `₦29,500 - ₦55,000`;
    const coursePriceUsd = `$59 - $99`;
    const upsell = `🔥 VIP Coaching / Community Access / Template Vault (₦15,000 add-on)`;
    
    // Final assembled prompt output
    const finalOutput = `
📘 DELIVERABLE 1 — EBOOK OUTLINE

- Ebook Title: ${ebookTitle}
- Subtitle: ${subtitle}
- Introduction: ${introPain} ${target} will gain a step-by-step system that eliminates guesswork.

${ebookChaptersText}

- Conclusion: ${conclusion}
- Bonus Section: ${bonus}
- Recommended Ebook Length: ${pages} pages
- Suggested Price Point: ${priceNgn} / ${priceUsd} (Nigerian/African market friendly)

---

🎓 DELIVERABLE 2 — ONLINE COURSE CURRICULUM

- Course Title: ${courseTitle}
- Course Tagline: ${tagline}
- Course Format: ${format}
- Ideal Platform: ${platform}

${modulesText}

- Estimated Course Length: ${estHours}
- Suggested Price Point: ${coursePriceNgn} / ${coursePriceUsd}
- Upsell Opportunity: ${upsell}

⚠️ Everything tied directly to solution steps: ${coreSteps.join(' → ')} and pain points: ${painPointsArray.slice(0, 3).join(', ')}.
    `;
    
    return finalOutput;
  }
  
  // DOM elements
  const productNameInput = document.getElementById('productName');
  const solutionStepsText = document.getElementById('solutionSteps');
  const painPointsText = document.getElementById('painPoints');
  const uvpInput = document.getElementById('uvp');
  const audienceInput = document.getElementById('audience');
  const generateBtn = document.getElementById('generateBtn');
  const resultDiv = document.getElementById('resultOutput');
  const copyBtn = document.getElementById('copyResultBtn');
  
  function updateResultWithSpinner() {
    resultDiv.innerHTML = `<div style="display:flex; justify-content:center; padding:2rem;"><div class="spinner"></div> <span style="margin-left:10px;">Generating smart product package...</span></div>`;
  }
  
  function escapeHtml(str) {
    return str.replace(/[&<>]/g, function(m) {
      if (m === '&') return '&amp;';
      if (m === '<') return '&lt;';
      if (m === '>') return '&gt;';
      return m;
    });
  }
  
  function renderOutput() {
    const product = productNameInput.value.trim() || "My Signature Solution";
    const stepsRaw = solutionStepsText.value;
    const painRaw = painPointsText.value;
    const uvp = uvpInput.value.trim() || "High-value proven process for fast results";
    const audience = audienceInput.value.trim() || "Ambitious professionals & entrepreneurs";
    
    const stepsArray = parseSteps(stepsRaw);
    const painArray = parsePainPoints(painRaw);
    
    const outputText = generateFullPackage(product, stepsArray, painArray, uvp, audience);
    resultDiv.innerHTML = `<pre>${escapeHtml(outputText)}</pre>`;
  }
  
  function handleGenerate() {
    updateResultWithSpinner();
    setTimeout(() => {
      renderOutput();
    }, 60);
  }
  
  function showToast(msg, duration = 2000) {
    let existingToast = document.querySelector('.toast-msg');
    if (existingToast) existingToast.remove();
    const toast = document.createElement('div');
    toast.className = 'toast-msg';
    toast.innerText = msg;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.remove();
    }, duration);
  }
  
  generateBtn.addEventListener('click', handleGenerate);
  
  copyBtn.addEventListener('click', () => {
    const rawText = resultDiv.innerText || resultDiv.textContent;
    if (!rawText || rawText.includes("click Generate Product Outline") || rawText.includes("Your complete ebook outline")) {
      showToast("⚠️ Generate a product outline first", 1500);
      return;
    }
    navigator.clipboard.writeText(rawText).then(() => {
      showToast("✅ Full product outline copied to clipboard!", 1800);
    }).catch(() => {
      showToast("❌ Could not copy manually", 1500);
    });
  });
  
  // Prefill demo content for better showcase
  if (!solutionStepsText.value) {
    solutionStepsText.value = "Step 1: Identify your niche & ideal offer\nStep 2: Create high-value portfolio samples\nStep 3: Outreach & lead generation system\nStep 4: Closing techniques & sales scripts\nStep 5: Retention & recurring revenue";
    painPointsText.value = "No clear step-by-step system\nFear of reaching out to prospects\nLow pricing and value perception\nInconsistent monthly income\nImposter syndrome";
    productNameInput.value = "Freelance Launch Formula";
    uvpInput.value = "Proven playbook that turns beginners into 6-figure freelancers in months";
    audienceInput.value = "Freelancers, creatives & remote workers";
  }
  
  // initial render
  setTimeout(() => {
    renderOutput();
  }, 20);
})();
